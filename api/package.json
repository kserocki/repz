{
  "name": "@repz/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repz backend API (Hono + Drizzle + Postgres)",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts | pino-pretty",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env src/db/seed/seed.ts",
    "import:wger": "node --env-file-if-exists=.env src/scripts/import-wger.ts",
    "openapi:export": "node src/scripts/export-openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@node-rs/argon2": "2.2.2",
    "@scalar/hono-api-reference": "0.12.17",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "jose": "6.2.14",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}

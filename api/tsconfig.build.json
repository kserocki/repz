{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/shared/testing/**",
    "src/db/migrate.ts",
    "src/scripts/**",
    "src/db/seed/**",
    "src/contract/**"
  ]
}
